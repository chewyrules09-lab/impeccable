# Copy to .env and fill in. Never commit the real .env file.

# --- Mode control -----------------------------------------------------------
# backtest | paper | live. Any missing/invalid value falls back to "paper" in code.
TRADING_MODE=paper

# Both of these AND a validation_report.json meeting the Phase 3 bar are required
# before TRADING_MODE=live is permitted to run. See validation/gate.py.
LIVE_CONFIRMED=false

# Kill switch. true = refuse new orders and attempt to flatten open positions, then exit.
KILL=false

# --- Risk limits (all checked by risk/engine.py before every order) --------
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_SIZE_PCT=10.0
MAX_TRADES_PER_DAY=5
MAX_CONCURRENT_POSITIONS=2
MAX_TOTAL_EXPOSURE_PCT=50.0
MAX_MARKET_DATA_AGE_SECONDS=60
ANOMALY_FILL_PRICE_DEVIATION_PCT=1.0
RISK_PER_TRADE_PCT=1.0

# --- Strategy config (ICT/TJR detector thresholds; see strategy/config.py) -
STRATEGY_SWING_LOOKBACK=2
STRATEGY_MIN_FVG_SIZE=0.0
STRATEGY_EQUAL_LEVEL_TOLERANCE_PCT=0.05
STRATEGY_LIQUIDITY_LOOKBACK_BARS=20
STRATEGY_ORDER_BLOCK_LOOKBACK_BARS=10
STRATEGY_STOP_BUFFER_PCT=0.05
STRATEGY_TARGET_R_MULTIPLE=2.0

# --- Kill zones (RTH only, ET) ----------------------------------------------
KILLZONE_AM_START=09:30
KILLZONE_AM_END=11:00
KILLZONE_PM_START=13:30
KILLZONE_PM_END=15:30
UNIVERSE=SPY,QQQ

# --- Phase 3 validation gate -------------------------------------------------
VALIDATION_MIN_PAPER_SESSIONS=20
VALIDATION_MIN_TRADES=30
VALIDATION_MIN_PROFIT_FACTOR=1.3
VALIDATION_MAX_DRAWDOWN_PCT=10.0
VALIDATION_MIN_EXPECTANCY_R=0.0

# --- Live funding (informational only; funding the account is a manual,
# out-of-band action this code never performs) ------------------------------
LIVE_STARTING_BALANCE_USD=200

# --- Alpaca (paper data + paper/live equities+options execution, Phase 2/3) -
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Robinhood Agentic Trading MCP (Phase 4 live execution rail only) ------
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Persistence -------------------------------------------------------------
DATABASE_PATH=./trading.db
